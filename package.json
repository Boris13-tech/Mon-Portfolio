{
    "name": "boris-portfolio",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@11.20.0",
    "scripts": {
        "dev": "next dev --webpack",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "typecheck": "tsc --noEmit",
