        "gray-matter": "latest",
        "lucide-react": "latest",
        "next": "16.3.1",
        "next-mdx-remote": "latest",
        "next-themes": "latest",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-hook-form": "latest",
        "reading-time": "latest",
        "resend": "latest",
        "tailwind-merge": "latest",
        "zod": "latest"
    },
    "devDependencies": {
        "@playwright/test": "1.62.1",
        "@tailwindcss/postcss": "4.3.3",
